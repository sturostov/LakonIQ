# Claude: вход через аккаунт прямо в приложении (кнопка «Войти через Claude»), ключ не нужен.
# Ключ Deepgram (распознавание речи): https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Необязательные настройки
CLAUDE_MODEL=claude-opus-5-5
# Глубина размышлений Claude — ползунок «🧠» в приложении. Здесь — уровень для живых ответов в режиме «Авто»
# (low = быстрее всего; medium/high = глубже, но дольше)
CLAUDE_EFFORT=low
DEEPGRAM_MODEL=nova-3
PORT=8765
